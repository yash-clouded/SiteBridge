# SiteBridge backend settings — TEMPLATE.
# Copy to .env (same directory) and fill in the blanks:
#   cp example.env .env
# .env is gitignored; this file is not. Never put a real key in here.

# --- App -------------------------------------------------------------------
APP_NAME=SiteBridge
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://sitebridge:sitebridge@localhost:5432/sitebridge
# Comma-separated: local portal + Next app, then the Vercel domain
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# --- JWT (Phase 2) ---------------------------------------------------------
# Generate one, e.g.:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- LLM extraction (Phase 4 + 11) -----------------------------------------
# Any OpenAI-compatible /chat/completions server.
#
# Phase 11 ladder: LLM_BASE_URL -> LLM_FALLBACK_* -> heuristic.
# With no usable endpoint at all, EXTRACTION_FALLBACK decides:
#   heuristic  -> the report is read by pattern matching (values the text
#                 does not state stay null) and the event records
#                 model=heuristic-v1 so the queue can show it
#   off        -> reports are stored verbatim, nothing is guessed, and no
#                 execution event is created
#
# NVIDIA NIM (recommended):
#   key   https://build.nvidia.com/settings   ->  nvapi-...
#   chat  nvidia/nemotron-3.5-lightning-30b-a3b (fast)
#         nvidia/nemotron-3-super-120b-a12b   (stronger)
#         deepseek-v4.1-flash, gpt-oss-20b, openai/gpt-oss-120b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_TIMEOUT_SECONDS=60
# If a server ever rejects `response_format`, the client retries without it
# and relies on the JSON-only prompt + strict parser instead.
LLM_JSON_MODE=true
LLM_TEMPERATURE=0
AUTO_EXTRACT_ON_INTAKE=true
#
# OpenAI:        LLM_BASE_URL=https://api.openai.com/v1   LLM_API_KEY=sk-...
# Self-hosted:   LLM_BASE_URL=http://localhost:11434/v1    LLM_API_KEY=(empty)
#
# Secondary rung — tried ONLY when the primary fails (timeout, 4xx/5xx,
# unusable body). A healthy primary is never bypassed.
#   LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
#   LLM_FALLBACK_API_KEY=
#   LLM_FALLBACK_MODEL=llama3.1
#
# What a report is extracted by when no endpoint answers (Phase 11):
#   heuristic | off
EXTRACTION_FALLBACK=heuristic

# --- Embeddings (Phase 5) --------------------------------------------------
# local  -> deterministic offline vectors; no key, reproducible (tests use this)
# openai -> any OpenAI-compatible /embeddings endpoint
# auto   -> openai when a key is configured, otherwise local
#
# NVIDIA embeddings (E5/Nemotron run in passage vs query mode, so
# EMBEDDING_INPUT_TYPE must be true — activities are indexed as `passage`,
# events are searched as `query`):
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
#   EMBEDDING_DIM=2048
#   EMBEDDING_INPUT_TYPE=true
# Changing EMBEDDING_DIM means the existing vector columns no longer match.
# Drop them (only vectors are lost) and rebuild after restarting:
#   docker exec -i sitebridge-db psql -U sitebridge -d sitebridge \
#     -c "DROP TABLE IF EXISTS event_embeddings, activity_embeddings;"
#   curl -X POST "http://localhost:8000/api/projects/1/embed?force=true" \
#        -H "Authorization: Bearer <planner token>"
#
# OpenAI: PROVIDER=openai  MODEL=text-embedding-3-small  DIM=1536
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_DIM=1536
EMBEDDING_INPUT_TYPE=false

# Phase 11: when the remote embedding provider fails, re-embed locally ONLY
# while this project's index is still local/empty — two vector spaces are
# never mixed (a wrong similarity score is worse than a clear error).
EMBEDDING_FALLBACK_LOCAL=true

# --- Retrieval (Phase 5) ---------------------------------------------------
RETRIEVAL_TOP_K=5
